# 填写自己的阿里云兼容接口配置。
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
TEXT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# Linux Lite使用文件路径；远程Milvus可设置为HTTP地址。
VECTOR_URI=/opt/zhixu/data/knowledge.db
MILVUS_TOKEN=
# 专用集合名，不与其他应用混用。
MILVUS_COLLECTION=bgw_knowledge_v1
# 密码有特殊字符时使用分项配置，由 SQLAlchemy 自动处理转义。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=bgw_agent
JWT_SECRET=
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001"]
IMPORT_ROOT=/opt/zhixu/imports
UPLOAD_DIR=/opt/zhixu/uploads
APP_TIMEZONE=Asia/Shanghai
# 上传与本地目录导入均受限，避免误读其他目录。
MAX_FILE_MB=30
MAX_IMPORT_FILES=100
